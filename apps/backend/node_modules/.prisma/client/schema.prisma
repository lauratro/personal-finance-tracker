generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum AccountType {
  CASH
  CHECKING
  SAVINGS
  CREDIT_CARD
  INVESTMENT
  CRYPTO
  OTHER
}

enum CategoryType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  BUY
  SELL
  DIVIDEND
  FEE
  INTEREST
  DEPOSIT
  WITHDRAWAL
}

enum AssetType {
  STOCK
  ETF
  CRYPTO
  BOND
  FUND
  CASH
  OTHER
}

enum MarketDataProvider {
  MANUAL
  YAHOO_FINANCE
  ALPHA_VANTAGE
  TWELVE_DATA
  OTHER
}

model User {
  id               String         @id @default(uuid())
  email            String         @unique
  passwordHash     String
  firstName        String?
  lastName         String?
  role             UserRole       @default(USER)
  twoFactorEnabled Boolean        @default(false)
  twoFactorSecret  String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  accounts         Account[]
  categories       Category[]
  transactions     Transaction[]
  budgetMonths     BudgetMonth[]
  portfolios       Portfolio[]
  refreshTokens    RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Account {
  id                String        @id @default(uuid())
  userId            String
  name              String
  type              AccountType
  currency          String        @default("EUR")
  institution       String?
  balance           Decimal       @default(0) @db.Decimal(18, 2)
  includeInNetWorth Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  linkedPortfolios  Portfolio[]   @relation("BrokerAccountPortfolio")

  @@unique([userId, name])
  @@index([userId, type])
}

model Category {
  id           String                @id @default(uuid())
  userId       String
  name         String
  type         CategoryType
  color        String?
  icon         String?
  isSystem     Boolean               @default(false)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgetLimits BudgetCategoryLimit[]

  @@unique([userId, name, type])
  @@index([userId, type])
}

model BudgetMonth {
  id             String                @id @default(uuid())
  userId         String
  monthStart     DateTime
  incomePlanned  Decimal               @default(0) @db.Decimal(18, 2)
  expensePlanned Decimal               @default(0) @db.Decimal(18, 2)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  limits         BudgetCategoryLimit[]

  @@unique([userId, monthStart])
  @@index([userId, monthStart])
}

model BudgetCategoryLimit {
  id            String      @id @default(uuid())
  budgetMonthId String
  categoryId    String
  amount        Decimal     @default(0) @db.Decimal(18, 2)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  budgetMonth   BudgetMonth @relation(fields: [budgetMonthId], references: [id], onDelete: Cascade)
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([budgetMonthId, categoryId])
}

model Portfolio {
  id              String           @id @default(uuid())
  userId          String
  name            String
  baseCurrency    String           @default("EUR")
  brokerAccountId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerAccount   Account?         @relation("BrokerAccountPortfolio", fields: [brokerAccountId], references: [id], onDelete: SetNull)
  holdings        Holding[]
  marketSnapshots MarketSnapshot[]
  transactions    Transaction[]

  @@unique([userId, name])
}

model Holding {
  id          String    @id @default(uuid())
  portfolioId String
  symbol      String
  name        String?
  assetType   AssetType
  quantity    Decimal   @default(0) @db.Decimal(24, 8)
  averageCost Decimal   @default(0) @db.Decimal(18, 4)
  currency    String    @default("EUR")
  exchange    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, symbol])
  @@index([symbol])
}

model MarketSnapshot {
  id          String             @id @default(uuid())
  portfolioId String
  symbol      String
  provider    MarketDataProvider @default(MANUAL)
  price       Decimal            @db.Decimal(18, 4)
  currency    String             @default("EUR")
  priceDate   DateTime
  capturedAt  DateTime           @default(now())
  portfolio   Portfolio          @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId, priceDate])
  @@index([symbol, priceDate])
}

model Transaction {
  id            String          @id @default(uuid())
  userId        String
  accountId     String
  categoryId    String?
  portfolioId   String?
  type          TransactionType
  amount        Decimal         @db.Decimal(18, 2)
  quantity      Decimal?        @db.Decimal(24, 8)
  unitPrice     Decimal?        @db.Decimal(18, 4)
  fee           Decimal?        @db.Decimal(18, 2)
  currency      String          @default("EUR")
  occurredAt    DateTime
  merchant      String?
  description   String?
  externalId    String?
  transferGroup String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  account       Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category      Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  portfolio     Portfolio?      @relation(fields: [portfolioId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([accountId, occurredAt])
  @@index([categoryId, occurredAt])
  @@index([portfolioId, occurredAt])
  @@index([type, occurredAt])
}
